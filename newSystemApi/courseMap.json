    "third_party_lead_enabled": "true",  // default to true

    "course_tags": "course_type_name", // tbl_course.type_of_course → tbl_course_type.id → course_type_name

    "share_enabled": "show_banner_share", // tbl_course_banner.show_banner_share Y=true, N=false

    "is_new": "is_new", // tbl_course.is_new Y=true, N=false

    "is_featured": "is_featured", // tbl_course.is_featured Y=true, N=false

    "short_description": "banner_sub_desc",  // tbl_course_banner.banner_sub_desc

    "ap_portal_course_id": "ap_id", // tbl_course.ap_id

    "edmingle_course_id": "edmingle_course_id", // tbl_course_plan_type_mapping.edmingle_course_id

    "ap_portal_course_catagory_id": "ap_course_cat_id", // tbl_course.ap_course_cat_id

    "get_study_material_enabled": "show_free_download",  //tbl_course_banner.show_free_download Y=true, N=false

    "study_material_email_template": "freedownload_msg", // tbl_course.freedownload_msg

    "counselling_call_enabled": "show_counselling_call",  // tbl_course.banner.show_counselling_call Y=true, N=false

    "join_waitlist_enabled": "true",   // default to true, do not read from CSV

    "join_waitlist_email_template": "join_the_waitlist_msg", // tbl_course.join_the_waitlist_msg

    "use_custom_study_material_template": "false",  // default to false

    "study_material_mapping_ids": [],  // filled at migrate time after study-material upload; default empty

    "use_custom_join_waitlist_email_template": "false",  // default to false

    "banner_phone": "banner_phone", // tbl_course_banner.banner_phone

    "show_banner_phone": "show_banner_phone", // tbl_course_banner.show_banner_phone Y=true, N=false

    "show_banner_tagline": "show_banner_tagline", // tbl_course_banner.show_banner_tagline Y=true, N=false

    "hide_last_enrollment_date": "show_enroll_close_date", // tbl_course_banner.show_enroll_close_date inverse of show_enroll_close_date: Y → send N, N → send Y (default N)

    "banner_tag_line": "banner_tagline", // tbl_course_banner.banner_tagline

    "show_learn_from": "show_learn_from",  // tbl_course.show_learn_from Y=true, N=false

    "learn_from": "learn_from", // tbl_course.learn_from

    "show_get_course_syllabus": "show_syllabus",    // tbl_course_banner.show_syllabus Y=true, N=false

    "get_course_syllabus_link": "get_course_syllebus_link",  // tbl_course.get_course_syllebus_link

    "refund_policy": "show_new_refund_policy", // tbl_course.show_new_refund_policy Y=true, N=false

    "logo_type": "show_govt_medhavi_logo", // tbl_course.show_govt_medhavi_logo 0,1,2,3

    "send_to_timepay": "false",  // default to false

