{
    "old_course_id": "id", // tbl_course.id

    "title": "course_name", // tbl_course.course_name

    "slug": "url_mask", // tbl_course.url_mask

    "course_content": "content_title+content_details", 

    "course_category": "type_of_course", //tbl_course.type_of_course

    "duration_minutes": "course_duration",   // my new db captures this in minutes but old db have a month (tbl_course.course_duration)

    "class_routine": "class_routine", // tbl_course.class_routine

    "is_published": "hide_from_list", // tbl_course.hide_from_list: Y=hide from list → is_published false; N=show in list → is_published true

