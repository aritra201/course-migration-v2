    "payment_enabled": "true",  // default to true

    "payment_gateway": "payment_gateway",  // tbl_course.payment_gateway (resolved directly from courseRow)

    "currency": "currency",  // tbl_course_plan_type_mapping.curr_name (resolved via coursePlanData.currency)

    "amount": "course_fee", // tbl_course_plan_type_mapping.orginal_price (overridden in buildPayload via coursePlanData.plan_original_price; rule "course_fee" would otherwise resolve to tbl_course.course_fee)

